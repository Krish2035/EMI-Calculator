# Server Port
PORT=5000

# PostgreSQL Configuration
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=postgres
PGDATABASE=emi_calculator
PGPORT=5432

# Read Replicas (Optional comma-separated list of replica URLs)
# DATABASE_READ_REPLICAS=postgresql://postgres:postgres@localhost:5433/emi_calculator

# Redis Configuration (Cache & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
JWT_SECRET=your_jwt_secret_token_here_change_in_production
